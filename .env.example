# Riot development key -- expires every 24h, regenerate at https://developer.riotgames.com
RIOT_API_KEY=

# Matches docker-compose.yml
RIFTWATCH_DATABASE_URL=postgresql://riftwatch:riftwatch@localhost:5432/riftwatch

# Used when a command is given a Riot ID without --region (na, euw, kr, ...)
RIFTWATCH_DEFAULT_REGION=na

# Coach (not used until the coach milestone)
ANTHROPIC_API_KEY=
RIFTWATCH_COACH_MODEL=claude-sonnet-5-5
