# Riot development key -- expires every 24h, regenerate at https://developer.riotgames.com
RIOT_API_KEY=

# Matches docker-compose.yml
RIFTWATCH_DATABASE_URL=postgresql://riftwatch:riftwatch@127.0.0.1:5432/riftwatch

# Used when a command is given a Riot ID without --region (na, euw, kr, ...)
RIFTWATCH_DEFAULT_REGION=na

# LLM coach. Without a key, `riftwatch coach` uses the offline template coach.
ANTHROPIC_API_KEY=
RIFTWATCH_COACH_MODEL=claude-sonnet-5-5
# low | medium | high -- lower is faster and cheaper
RIFTWATCH_COACH_EFFORT=low
# adaptive | between_tools (no extended thinking, Sonnet 5.5 only). Measured on a real
# game: adaptive+low was cheapest and fastest (~$0.010, ~8 s, no grounding retries).
RIFTWATCH_COACH_THINKING=adaptive
